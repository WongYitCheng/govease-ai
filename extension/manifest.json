{
  "manifest_version": 3,
  "name": "GovEase AI",
  "version": "1.0",
  "description": "Auto-fill Malaysian government portal forms",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "GovEase AI"
  }
}